+/* Birdman64VR, for the log only (tracker x1): G_NOOP tags telling the
+ * renderer what the environment is and which of its models the following
+ * draws belong to (pw64-gfx interp ENV_HEAD_TAG / ENV_MODEL_TAG,
+ * Frame::env_log). Nothing is drawn differently. */
+#define PW64_ENV_HEAD_TAG 0x454800u  /* "EH" + value index */
+#define PW64_ENV_MODEL_TAG 0x454D00u /* "EM" + model index, 0xFF callback */
+
+static void pw64_env_word(u32 w0, u32 w1) {
+    gGfxDisplayListHead->words.w0 = ((u32)G_NOOP << 24) | w0;
+    gGfxDisplayListHead->words.w1 = w1;
+    gGfxDisplayListHead++;
+}
+
+static void pw64_env_head(s32 chan, s32 envId, ParsedUVEN* uven) {
+    UnkStruct_80204D94* c = &D_80261730[chan];
+    float v[26];
+    s32 i, k;
+    v[0] = (float)chan;
+    v[1] = (float)envId;
+    v[2] = (float)uven->modelCount;
+    v[3] = (float)uven->clearEnabled;
+    v[4] = (float)uven->screenR;
+    v[5] = (float)uven->screenG;
+    v[6] = (float)uven->screenB;
+    v[7] = (float)uven->screenA;
+    v[8] = (float)uven->fogEnabled;
+    v[9] = uven->fogMin;
+    v[10] = uven->fogMax;
+    v[11] = (float)uven->fogR;
+    v[12] = (float)uven->fogG;
+    v[13] = (float)uven->fogB;
+    for (i = 0; i < 4; i++) {
+        for (k = 0; k < 3; k++) {
+            v[14 + i * 3 + k] = c->unk110.m[i][k];
+        }
+    }
+    for (i = 0; i < 26; i++) {
+        union {
+            float f;
+            u32 u;
+        } bits;
+        bits.f = v[i];
+        pw64_env_word(PW64_ENV_HEAD_TAG | (u32)i, bits.u);
+    }
+}
+
