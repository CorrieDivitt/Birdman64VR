+// PW64 VR: env_802E0CF0's haze band is a card across the view at the far
+// plane, where the far plane cuts the camera-following sea: on a monitor it
+// blends that cut into the sky. In the headset there is no far-plane cut
+// and the player looks all around: the card stood in the sea at a fixed
+// distance and the sea went on behind it. This is the same band as a ring
+// around the camera on the sea (z = 0): clear at 0.875 far, fog-coloured
+// from far out to 30 km, past the sea model's edge, so the sea fades into
+// the haze in every direction. Vertices are s16, hence the 30 km.
+static void pw64_vr_haze_ring(f32 cx, f32 cy, f32 far, u8 r, u8 g, u8 b) {
+    Mtx4F m;
+    f32 radius[3];
+    f32 c0, s0, c1, s1;
+    s32 i, k;
+
+    radius[0] = 0.875f * far;
+    radius[1] = far;
+    radius[2] = 30000.0f;
+    if (radius[1] >= radius[2]) {
+        return;
+    }
+    uvMat4SetIdentity(&m);
+    m.m[3][0] = cx;
+    m.m[3][1] = cy;
+    uvGfxStatePush();
+    uvGfxSetFlags(GFX_STATE_XLU | GFX_STATE_AA | GFX_STATE_GOURAUD | GFX_STATE_TEXTURE_NONE);
+    // Both faces: the ring is seen from above and its winding is not the
+    // card's (the first build without this showed nothing).
+    uvGfxClearFlags(GFX_STATE_DECAL | GFX_STATE_ZBUFFER | GFX_STATE_CULL_FRONT | GFX_STATE_CULL_BACK);
+    uvGfx_802236CC(&m);
+    for (i = 0; i < 32; i++) {
+        c0 = uvCosF(i * (6.2831855f / 32.0f));
+        s0 = uvSinF(i * (6.2831855f / 32.0f));
+        c1 = uvCosF((i + 1) * (6.2831855f / 32.0f));
+        s1 = uvSinF((i + 1) * (6.2831855f / 32.0f));
+        for (k = 0; k < 2; k++) {
+            uvVtxBeginPoly();
+            uvVtx(c0 * radius[k], s0 * radius[k], 0, 0, 0, r, g, b, (k == 0) ? 0 : 0xFF);
+            uvVtx(c1 * radius[k], s1 * radius[k], 0, 0, 0, r, g, b, (k == 0) ? 0 : 0xFF);
+            uvVtx(c1 * radius[k + 1], s1 * radius[k + 1], 0, 0, 0, r, g, b, 0xFF);
+            uvVtx(c0 * radius[k + 1], s0 * radius[k + 1], 0, 0, 0, r, g, b, 0xFF);
+            uvVtxEndPoly();
+        }
+    }
+    uvGfxMtxViewPop();
+    uvGfxStatePop();
+}
 
