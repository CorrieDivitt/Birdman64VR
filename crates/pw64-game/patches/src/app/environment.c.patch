+// PW64 VR: env_802E0CF0's haze band is a card across the view at the far
+// plane, where the far plane cuts the camera-following sea: on a monitor it
+// blends that cut into the sky. In the headset there is no far-plane cut
+// and the player looks all around, so the band is a ring around the camera
+// on the sea (z = 0) instead. It thickens with distance like real haze:
+// clear at 0.875 far (as the card), then rising quickly and levelling off,
+// fully fog-coloured at 17 km (the sea model ends at about 17.7 km) and on
+// out to 30 km (vertices are s16). A solid band from the far plane looked
+// like a wall from altitude. One triangle strip per segment, outwards:
+// 24 x 14 dynamic vertices of the frame's 800.
+#define PW64_HAZE_SEGMENTS 24
+#define PW64_HAZE_STEPS 7
+static void pw64_vr_haze_ring(f32 cx, f32 cy, f32 far, u8 r, u8 g, u8 b) {
+    // Where along the haze (0 at its start, 1 at full) each step is.
+    static const f32 along[PW64_HAZE_STEPS] = { 0.0f, 0.1f, 0.25f, 0.45f, 0.7f, 1.0f, 1.0f };
+    Mtx4F m;
+    f32 radius[PW64_HAZE_STEPS];
+    u8 alpha[PW64_HAZE_STEPS];
+    f32 start, full, t, c0, s0, c1, s1;
+    s32 i, k;
+
+    // Infinite view distance can make far huge: the haze still starts
+    // within the sea.
+    start = 0.875f * ((far < 8000.0f) ? far : 8000.0f);
+    full = 17000.0f;
+    for (k = 0; k < PW64_HAZE_STEPS; k++) {
+        t = along[k];
+        radius[k] = start + (full - start) * t;
+        // Ease out: 1 - (1 - t)^2.
+        alpha[k] = (u8)(255.0f * (1.0f - (1.0f - t) * (1.0f - t)));
+    }
+    radius[PW64_HAZE_STEPS - 1] = 30000.0f;
+    uvMat4SetIdentity(&m);
+    m.m[3][0] = cx;
+    m.m[3][1] = cy;
+    uvGfxStatePush();
+    uvGfxSetFlags(GFX_STATE_XLU | GFX_STATE_AA | GFX_STATE_GOURAUD | GFX_STATE_TEXTURE_NONE);
+    // Both faces: the ring is seen from above and its winding is not the
+    // card's (with culling on it did not show).
+    uvGfxClearFlags(GFX_STATE_DECAL | GFX_STATE_ZBUFFER | GFX_STATE_CULL_FRONT | GFX_STATE_CULL_BACK);
+    uvGfx_802236CC(&m);
+    for (i = 0; i < PW64_HAZE_SEGMENTS; i++) {
+        c0 = uvCosF(i * (6.2831855f / PW64_HAZE_SEGMENTS));
+        s0 = uvSinF(i * (6.2831855f / PW64_HAZE_SEGMENTS));
+        c1 = uvCosF((i + 1) * (6.2831855f / PW64_HAZE_SEGMENTS));
+        s1 = uvSinF((i + 1) * (6.2831855f / PW64_HAZE_SEGMENTS));
+        uvBeginTmesh();
+        for (k = 0; k < PW64_HAZE_STEPS; k++) {
+            uvVtx(c0 * radius[k], s0 * radius[k], 0, 0, 0, r, g, b, alpha[k]);
+            uvVtx(c1 * radius[k], s1 * radius[k], 0, 0, 0, r, g, b, alpha[k]);
+        }
+        uvEndTmesh();
+    }
+    uvGfxMtxViewPop();
+    uvGfxStatePop();
+}
 
