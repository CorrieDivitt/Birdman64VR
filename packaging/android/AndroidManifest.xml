<?xml version="1.0" encoding="utf-8"?>
<!--
  Birdman64 for Android: a NativeActivity (with one small Java subclass,
  PwActivity: the SAF ROM picker result forwarding) that loads
  libbirdman64.so and calls its android_main. build-apk.sh packages it;
  docs/notes/android.md has the details. Birdman64VR: the package id is
  app.birdman64vr so the fork installs next to Birdman64; the Java class
  keeps its app.birdman64 package (the JNI names in rom_picker.rs and
  save_picker.rs follow the class, not the package id). versionName and
  versionCode come from the
  Cargo.toml version (build-apk.sh).

  Birdman64VR, Quest flavour (build-apk.sh quest option): the blocks between
  the QUEST marker lines are comments in the phone flavour; the script
  removes the marker lines, which turns them into manifest entries. So no
  comments inside those blocks.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.birdman64vr">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- First-run build (release flavour): downloads the open-source decomp
         once (docs/notes/android.md). A normal permission: no prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- wgpu: Vulkan first, GLES 3 as the fallback. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Quest: a VR app (head tracking required), and what the Khronos
         OpenXR loader needs to find the headset's runtime (the entries its
         AAR would merge in under Gradle). PASSTHROUGH: without it the
         runtime does not offer XR_FB_passthrough (the room behind the
         menus); not required, so headsets without it still install. -->
    <!--QUEST
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>
    QUEST-->

    <!-- No android:isGame / appCategory="game": on the test device (120 Hz
         panel) that classification brought a 60 fps game frame-rate
         override for the app, which held even with a requested rate
         (ANativeWindow_setFrameRate). Hiding the system bars is done in code. -->
    <!-- hasCode is true (the default): PwActivity is real Java. -->
    <application
        android:label="Birdman64VR"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasFragileUserData="true"
        android:extractNativeLibs="true">
        <!-- Quest: the headsets this runs on natively (others would show it
             in compatibility mode). -->
        <!--QUEST
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        QUEST-->
        <!-- Landscape only; a pad connecting (keyboard|navigation) or any
             other listed change must not restart the activity: the game
             thread and its OS core live for the whole process. -->
        <activity
            android:name="app.birdman64.PwActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale|touchscreen|colorMode"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="birdman64" />
            <!-- Quest: keep running (not paused) under the system menu. -->
            <!--QUEST
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            QUEST-->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Quest: start in VR instead of as a 2D panel. -->
                <!--QUEST
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                QUEST-->
            </intent-filter>
        </activity>
    </application>
</manifest>
